<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Con color dinámico el fondo de la app sale de la paleta del sistema; el neutro dinámico
         queda cerca de ese fondo, así que el arranque no muestra otro tono antes de Compose. -->
    <style name="Theme.CalNotas" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/system_neutral1_10</item>
        <item name="android:windowSplashScreenBackground">@android:color/system_neutral1_10</item>
    </style>
</resources>
